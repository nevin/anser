+    export fn ghostty_surface_recent_output(surface: *Surface, buf: [*]u8, cap: usize) usize {
+        const recent = switch (surface.core_surface.io.backend) {
+            .exec => |*exec| exec.recent,
+        } orelse return 0;
+        return recent.copyOut(buf[0..cap]);
+    }
+
+    /// Anser: how many bytes of output an adopted pty has produced so far
+    /// (including its initial output). Changes whenever there's new output.
+    export fn ghostty_surface_recent_output_total(surface: *Surface) u64 {
