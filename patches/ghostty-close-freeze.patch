+    /// Like `send`, but once `closing` is set a message that would wait for a
+    /// full queue is dropped: the IO thread that drains it is stopping and may
+    /// be waiting for the caller.
+    pub fn sendUnlessClosing(
+        self: *Mailbox,
+        msg: termio.Message,
+        mutex: ?*std.Io.Mutex,
+        closing: *const std.atomic.Value(bool),
+    ) void {
+        switch (self.*) {
+            .spsc => |*mb| send: {
+                if (mb.queue.push(global.io(), msg, .{ .instant = {} }) > 0) break :send;
+                mb.wakeup.notify() catch |err| {
+                    log.warn("failed to wake up writer, data will be dropped err={}", .{err});
+                    msg.deinit();
+                    return;
+                };
+                if (mutex) |m| m.unlock(global.io());
+                defer if (mutex) |m| m.lockUncancelable(global.io());
+                while (true) {
+                    if (closing.load(.acquire)) {
+                        msg.deinit();
+                        break;
+                    }
+                    if (mb.queue.push(global.io(), msg, .{ .ns = 5 * std.time.ns_per_ms }) > 0) break;
+                }
+            },
+        }
+    }
+
     /// Notify that there are new messages. This may be a noop depending
     /// on the writer type.
     pub fn notify(self: *Mailbox) void {
