+/// Set when the surface starts closing. Its renderer and IO threads are
+/// stopping (or already stopped) and the app thread may be waiting for them,
+/// so messages that would wait for a full mailbox to drain are dropped
+/// instead of waiting forever (which could deadlock the close).
+closing: std.atomic.Value(bool) = .init(false),
+
+/// How long a send to a full mailbox waits between checks of `closing`.
+pub const closing_poll_ns = 5 * std.time.ns_per_ms;
+
