+/// Anser: the last couple of megabytes of output of an adopted terminal,
+/// so the embedder can hand them to whoever shows this shell next (after
+/// a restart). Written by the read thread, read from the app thread.
+pub const RecentOutput = struct {
+    pub const capacity = 2 * 1024 * 1024;
+
+    alloc: Allocator,
+    mutex: std.Io.Mutex = .init,
+    buf: []u8,
+    /// Where the next byte goes.
+    head: usize = 0,
+    /// Valid bytes in buf (at most capacity).
+    len: usize = 0,
+    /// Bytes ever appended. Lets the embedder skip unchanged terminals.
+    total: u64 = 0,
+
+    pub fn create(alloc: Allocator) !*RecentOutput {
+        const self = try alloc.create(RecentOutput);
+        errdefer alloc.destroy(self);
+        self.* = .{ .alloc = alloc, .buf = try alloc.alloc(u8, capacity) };
+        return self;
+    }
+
+    pub fn destroy(self: *RecentOutput) void {
+        const alloc = self.alloc;
+        alloc.free(self.buf);
+        alloc.destroy(self);
+    }
+
+    pub fn append(self: *RecentOutput, data_: []const u8) void {
+        if (data_.len == 0) return;
+        self.mutex.lockUncancelable(global.io());
+        defer self.mutex.unlock(global.io());
+        self.total += data_.len;
+        const data = if (data_.len > capacity) data_[data_.len - capacity ..] else data_;
+        const first = @min(data.len, capacity - self.head);
+        @memcpy(self.buf[self.head..][0..first], data[0..first]);
+        @memcpy(self.buf[0 .. data.len - first], data[first..]);
+        self.head = (self.head + data.len) % capacity;
+        self.len = @min(capacity, self.len + data.len);
+    }
+
+    pub fn totalBytes(self: *RecentOutput) u64 {
+        self.mutex.lockUncancelable(global.io());
+        defer self.mutex.unlock(global.io());
+        return self.total;
+    }
+
+    /// Copies the newest bytes into out and returns how many. If older
+    /// output was cut off, the copy starts after the first line break so
+    /// it doesn't begin halfway through a line or escape sequence.
+    pub fn copyOut(self: *RecentOutput, out: []u8) usize {
+        self.mutex.lockUncancelable(global.io());
+        defer self.mutex.unlock(global.io());
+        const n = @min(out.len, self.len);
+        if (n == 0) return 0;
+        const start = (self.head + capacity - n) % capacity;
+        const first = @min(n, capacity - start);
+        @memcpy(out[0..first], self.buf[start..][0..first]);
+        @memcpy(out[first..n], self.buf[0 .. n - first]);
+        if (n == self.total) return n;
+        const nl = std.mem.indexOfScalar(u8, out[0..n], '\n') orelse return n;
+        const rest = n - (nl + 1);
+        std.mem.copyForwards(u8, out[0..rest], out[nl + 1 .. n]);
+        return rest;
+    }
+};
